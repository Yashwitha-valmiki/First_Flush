# Local server
PORT=8787
NODE_ENV=development

# Weather provider
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_MS=900000

# Browser/API security
# In local development this is the same origin. For Amplify, set this to the deployed site URL.
ALLOWED_ORIGIN=http://localhost:8787
MAX_UPLOAD_BYTES=5242880

# Optional production adapters (never expose secrets in frontend code)
AWS_REGION=ap-south-1
DYNAMODB_TABLE_PREFIX=firstflush
S3_BUCKET=
BEDROCK_MODEL_ID=
